# Container environment for the demo VM -> /etc/agentic-city.env (chmod 600).
#
# Versioned as a template because two of these settings are load-bearing in ways
# that are not obvious from their names, and both were discovered the hard way.
# Copy, fill in API_TOKEN, and install with mode 600.

# --- the service's own listener -------------------------------------------
# 127.0.0.1, NOT 0.0.0.0. redeploy.sh runs the container with --network host, so
# the container shares the host's network namespace: 0.0.0.0 here would bind the
# VM's public-facing interface directly rather than only loopback. The NSG has no
# inbound rule for 9000 and the load balancer has no rule for it either, so it
# would not actually be reachable — but nginx is meant to be the only public
# listener, and relying on two other layers to enforce that is not the design.
NSDEPLOY_SERVICE_HOST=127.0.0.1

# --- where deployed sites bind --------------------------------------------
# Loopback, which is nsdeploy's own default, so `--host` is never passed. That
# flag is the one thing this project ever added to the engine and three upstream
# drops removed it, each time producing sites that reported `ready` and served
# nothing. With --network host, loopback inside the container is the host's
# loopback, which is where nginx proxies. Do not set this to 0.0.0.0.
NSDEPLOY_SERVICE_DEPLOY_HOST=127.0.0.1

# --- how the returned URL is spelled --------------------------------------
# Baked into every generated bundle via --site-url, so it must match what a
# browser will actually reach. Changing it does not rewrite existing bundles.
NSDEPLOY_SERVICE_PUBLIC_SCHEME=https
NSDEPLOY_SERVICE_PUBLIC_HOST=agentic-city.example.com

# --- port pool -------------------------------------------------------------
# Must match three other things or deployments get URLs that answer nothing:
# the nginx server blocks, the NSG `sites` rule, and the load balancer rules.
NSDEPLOY_SERVICE_PORT_START=8100
NSDEPLOY_SERVICE_PORT_END=8119
NSDEPLOY_SERVICE_MAX_DEPLOYMENTS=20

# --- suppress a warning that is wrong on this host -------------------------
# /health otherwise reports that site URLs will not resolve, because the check
# reads configuration only and cannot see that nginx terminates TLS on every port
# of the pool. Without this the console shows a permanent false alarm.
NSDEPLOY_SERVICE_TLS_TERMINATED_EXTERNALLY=1

# --- credentials -----------------------------------------------------------
# Generate fresh (`openssl rand -hex 24`). Do NOT reuse the value committed in
# nsdeploy_service/.env: that one is in git history and was briefly stored as an
# organization name, where it rendered in the console UI.
NSDEPLOY_SERVICE_API_TOKEN=
