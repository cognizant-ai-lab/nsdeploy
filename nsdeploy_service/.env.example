# Example environment for the nsdeploy service. Copy to .env and fill in.
# The real .env is git-ignored: it holds live credentials and must not be committed.

# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
NSDEPLOY_SERVICE_API_TOKEN=
# Origins allowed to call this API from a browser on another host, comma separated.
# Empty (the default) sends no CORS headers at all. Each entry is scheme://host[:port]
# with no path. Needed only by a client served from somewhere other than this service.
NSDEPLOY_SERVICE_CORS_ORIGINS=
OPENAI_API_KEY=<your key here>>
NSDEPLOY_SERVICE_UPSTREAM=http://127.0.0.1:9800/admin/public/llm/v1
NSDEPLOY_SERVICE_THEME_MODEL=gpt-5.5
NSDEPLOY_SERVICE_THEME=true
NSDEPLOY_SERVICE_THEME_PROMPT=
NSDEPLOY_SERVICE_THEME_REFRESH=false
NSDEPLOY_ADMIN_LLM_RELAY=1
NSDEPLOY_ADMIN_EXPOSE_KEYS_TO_CONSOLE=0
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
